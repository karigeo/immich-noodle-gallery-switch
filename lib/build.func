#!/usr/bin/env bash
# shellcheck shell=bash
#
# lib/build.func — flavor-agnostic source build for a community-scripts Immich LXC.
#
# Copyright (c) 2026 — MIT
# Derived from community-scripts/ProxmoxVE ct/immich.sh and install/immich-install.sh
# SYNCED-FROM: ct/immich.sh @ 33de14e45cbae374f3ae33386824e4bde0a5e8ce (2026-08-07)
#
# Immich and Noodle Gallery share workspace package names, build entry points, the
# pnpm version, env var prefix, database name and machine-learning extras, so one
# build implementation serves both. Only the GitHub repo and tag differ.
#
# Requires misc/core.func and misc/tools.func to have been sourced first.

# ------------------------------------------------------------------------------
# flavor_paths()
#
# Resolves every path the build touches into globals. UPLOAD_DIR comes from the
# live .env so bind-mounted media locations are honoured.
# ------------------------------------------------------------------------------
flavor_paths() {
  INSTALL_DIR="${INSTALL_DIR:-/opt/immich}"
  SRC_DIR="${INSTALL_DIR}/source"
  APP_DIR="${INSTALL_DIR}/app"
  PLUGIN_DIR="${APP_DIR}/plugins/immich-plugin-core"
  ML_DIR="${APP_DIR}/machine-learning"
  GEO_DIR="${INSTALL_DIR}/geodata"
  BACKUP_ROOT="${INSTALL_DIR}/backups"
  FLAVOR_FILE="${INSTALL_DIR}/.flavor"
  FLAVOR_STATE_DIR="${INSTALL_DIR}/.flavor.d"

  UPLOAD_DIR=""
  if [[ -f "${INSTALL_DIR}/.env" ]]; then
    UPLOAD_DIR="$(sed -n '/^IMMICH_MEDIA_LOCATION/s/[^=]*=//p' "${INSTALL_DIR}/.env")"
  fi
  UPLOAD_DIR="${UPLOAD_DIR:-${INSTALL_DIR}/upload}"

  export INSTALL_DIR SRC_DIR APP_DIR PLUGIN_DIR ML_DIR GEO_DIR UPLOAD_DIR
  export BACKUP_ROOT FLAVOR_FILE FLAVOR_STATE_DIR
}

# ------------------------------------------------------------------------------
# flavor_version_file <app-label>
#
# Mirrors the naming fetch_and_deploy_gh_release uses for its version marker:
# lowercase, spaces stripped, under $HOME. "Gallery" -> ~/.gallery.
# ------------------------------------------------------------------------------
flavor_version_file() {
  local label_lc
  label_lc="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
  echo "${HOME}/.${label_lc}"
}

# ------------------------------------------------------------------------------
# flavor_stash_start_scripts()
#
# ml_start.sh and bin/start.sh are generated by the installer, not shipped in the
# source tarball, so they must survive the app/ wipe. Regenerates start.sh if the
# existing copy predates the "set -a" form (same check as ct/immich.sh).
# ------------------------------------------------------------------------------
flavor_stash_start_scripts() {
  [[ -f "${ML_DIR}/ml_start.sh" ]] && cp "${ML_DIR}/ml_start.sh" "${INSTALL_DIR}"

  if grep -qs "set -a" "${APP_DIR}/bin/start.sh" && grep -qs "warnings" "${APP_DIR}/bin/start.sh"; then
    cp "${APP_DIR}/bin/start.sh" "${INSTALL_DIR}"
  else
    cat <<EOF >"${INSTALL_DIR}/start.sh"
#!/usr/bin/env bash

set -a
. ${INSTALL_DIR}/.env
set +a

/usr/bin/node --no-warnings ${APP_DIR}/dist/main.js "\$@"
EOF
    chmod +x "${INSTALL_DIR}/start.sh"
  fi
  return 0
}

# ------------------------------------------------------------------------------
# flavor_restore_ml_start()
#
# Puts ml_start.sh back, regenerating it if a previous interrupted run lost it
# (otherwise immich-ml.service fails with status=203/EXEC).
# ------------------------------------------------------------------------------
flavor_restore_ml_start() {
  [[ -f "${INSTALL_DIR}/ml_start.sh" ]] && mv "${INSTALL_DIR}/ml_start.sh" "${ML_DIR}"

  if [[ ! -f "${ML_DIR}/ml_start.sh" ]]; then
    cat <<EOF >"${ML_DIR}/ml_start.sh"
#!/usr/bin/env bash

cd ${ML_DIR}
. ${ML_DIR}/ml-venv/bin/activate

set -a
. ${INSTALL_DIR}/.env
set +a

python3 -m immich_ml
EOF
  fi
  chmod +x "${ML_DIR}/ml_start.sh"
}

# ------------------------------------------------------------------------------
# flavor_chown_install()
#
# chown the install tree to immich:immich, but never recurse into upload/ — it may
# be a mount with restricted permissions and can hold hundreds of thousands of files
# — nor into backups/, whose dumps stay owned by postgres so pg_restore can read them.
# ------------------------------------------------------------------------------
flavor_chown_install() {
  chown immich:immich "$INSTALL_DIR"
  find "$INSTALL_DIR" -maxdepth 1 -mindepth 1 ! -name upload ! -name backups \
    -exec chown -R immich:immich {} +
  chown immich:immich "$UPLOAD_DIR" 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# flavor_patch_media_repository()
#
# MickLesk's HEIC thumbnail hotfix, carried over from the upstream scripts: it
# passed { unlimited: true, limitInputPixels: false } to the sharp() call that
# reads image metadata.
#
# As of Immich v3.1.0 — and therefore Gallery v5.3.1, which is rebased on it —
# the source already reads `sharp(input, { unlimited: true }).metadata()`, so the
# patch no longer matches anything in either flavor. It is kept because it costs
# nothing and would catch an upstream regression, but the outcome is reported
# precisely instead of the bare "pattern not found", which read like a failure.
#
# The one thing upstream did not adopt is limitInputPixels: false, so sharp's
# default cap of ~268 megapixels still applies. That is true of a stock Immich
# install too, and only matters for extremely large panoramas or scans.
# ------------------------------------------------------------------------------
flavor_patch_media_repository() {
  local repo_js="${APP_DIR}/dist/repositories/media.repository.js" outcome
  [[ -f "$repo_js" ]] || return 0

  msg_info "Checking media.repository.js sharp options"
  # Captured rather than printed straight out, so the result cannot land in the
  # middle of the spinner line.
  outcome="$(MEDIA_REPO_JS="$repo_js" python3 - <<'PY'
import os
import re
from pathlib import Path

p = Path(os.environ['MEDIA_REPO_JS'])
s = p.read_text()
old = "(0, sharp_1.default)(input).metadata()"
new = "(0, sharp_1.default)(input, { unlimited: true, limitInputPixels: false }).metadata()"

if new in s:
    print('already patched by a previous run')
elif old in s:
    p.write_text(s.replace(old, new, 1))
    print('hotfix applied')
elif re.search(r'sharp_1\.default\)\(input,\s*\{[^}]*unlimited:\s*true', s):
    print('not needed, upstream already passes { unlimited: true }')
else:
    print('call site not recognised, left alone')
PY
  )"
  msg_ok "media.repository.js: ${outcome}"
}

# ------------------------------------------------------------------------------
# flavor_build_app <app-label> <gh-repo> <tag>
#
#   flavor_build_app "Gallery" "open-noodle/gallery" "v5.3.1"
#   flavor_build_app "Immich"  "immich-app/immich"   "v3.1.0"
#
# Rebuilds /opt/immich/app from the given release tarball. Everything outside
# app/ and source/ — postgres, redis, the compiled C libraries, .env, the systemd
# units and upload/ — is left untouched.
#
# Honours FLAVOR_KEEP_APP_DIR=1 when the caller has already moved app/ aside as a
# rollback snapshot (so this function must not delete it a second time).
# ------------------------------------------------------------------------------
flavor_build_app() {
  local app_label="$1" gh_repo="$2" tag="$3"

  flavor_paths

  # fetch_and_deploy_gh_release short-circuits when its version marker already
  # matches the requested tag, which would leave the *other* flavor's source in
  # place. We always want a real fetch here, so drop the marker first; it is
  # rewritten by the fetch and reflects what was actually built.
  rm -f "$(flavor_version_file "$app_label")"
  unset var_appversion

  flavor_stash_start_scripts

  if [[ "${FLAVOR_KEEP_APP_DIR:-0}" != "1" ]]; then
    (
      shopt -s dotglob
      rm -rf "${APP_DIR:?}"/*
    )
  fi
  mkdir -p "$APP_DIR"

  # Native addon builds (sharp, bcrypt) need a toolchain; gcc-13 is the fallback
  # compiler the installer provisions for sources trixie's gcc-14 rejects.
  ensure_dependencies ccache gcc-13 g++-13 jq
  setup_uv
  CLEAN_INSTALL=1 fetch_and_deploy_gh_release "$app_label" "$gh_repo" "tarball" "$tag" "$SRC_DIR"

  local pnpm_version
  pnpm_version="$(jq -r '.packageManager | split("@")[1] | split("+")[0]' "${SRC_DIR}/package.json")"
  export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
  export CI=1
  NODE_VERSION="24" NODE_MODULE="corepack" setup_nodejs
  $STD corepack prepare "pnpm@${pnpm_version}" --activate
  export PATH="/root/.local/share/pnpm/bin:$PATH"
  $STD pnpm config set --global dangerouslyAllowAllBuilds true

  msg_info "Building ${app_label} server (patience)"
  cd "${SRC_DIR}/server" || return 1
  # sharp must be built against the system libvips compiled by the installer, but
  # the SDK/web builds must not be, hence the flag flip-flopping below.
  export SHARP_IGNORE_GLOBAL_LIBVIPS=true
  $STD pnpm --filter @immich/sdk --filter @immich/plugin-sdk --filter immich build
  unset SHARP_IGNORE_GLOBAL_LIBVIPS
  export SHARP_FORCE_GLOBAL_LIBVIPS=true
  $STD pnpm --filter immich --prod --no-optional deploy "$APP_DIR"

  # Disable upgrade-insecure-requests so plain-HTTP access keeps working.
  if [[ -f "${APP_DIR}/helmet.json" ]]; then
    jq '.contentSecurityPolicy.directives["upgrade-insecure-requests"] = null' \
      "${APP_DIR}/helmet.json" >"${APP_DIR}/helmet.json.tmp" &&
      mv "${APP_DIR}/helmet.json.tmp" "${APP_DIR}/helmet.json"
  fi

  cp "${APP_DIR}/package.json" "${APP_DIR}/bin"
  sed -i "s|^start|${APP_DIR}/bin/start|" "${APP_DIR}/bin/immich-admin"
  msg_ok "Built ${app_label} server"

  msg_info "Building ${app_label} web and CLI"
  cd "$SRC_DIR" || return 1
  echo "packageImportMethod: hardlink" >>./pnpm-workspace.yaml
  unset SHARP_FORCE_GLOBAL_LIBVIPS
  export SHARP_IGNORE_GLOBAL_LIBVIPS=true
  $STD pnpm --filter @immich/sdk --filter immich-web --filter @immich/cli build
  $STD pnpm --filter @immich/cli --prod --no-optional deploy "${APP_DIR}/cli"
  cp -a web/build "${APP_DIR}/www"
  cp LICENSE "$APP_DIR"
  [[ -f "${INSTALL_DIR}/start.sh" ]] && mv "${INSTALL_DIR}/start.sh" "${APP_DIR}/bin"
  chmod +x "${APP_DIR}/bin/start.sh"
  msg_ok "Built ${app_label} web and CLI"

  flavor_build_plugins "$app_label"
  flavor_build_ml "$app_label"

  msg_info "Wiring up ${app_label} paths"
  ln -sf "${APP_DIR}/resources" "$INSTALL_DIR"
  cd "$APP_DIR" || return 1
  # No match is unexpected but not fatal — the paths may already be rewritten.
  grep -rl /usr/src | xargs -r -n1 sed -i "s|\/usr/src|$INSTALL_DIR|g" || true
  grep -rlE "'/build'" | xargs -r -n1 sed -i "s|'/build'|'$APP_DIR'|g" || true
  sed -i "s@\"/cache\"@\"$INSTALL_DIR/cache\"@g" "${ML_DIR}/immich_ml/config.py"

  if [[ ! -f "${GEO_DIR}/countryInfo.txt" ]]; then
    mkdir -p "$GEO_DIR"
    (cd "$GEO_DIR" && curl_with_retry "https://download.geonames.org/export/dump/countryInfo.txt" "countryInfo.txt")
  fi

  ln -sfn "$UPLOAD_DIR" "${APP_DIR}/upload"
  ln -sfn "$UPLOAD_DIR" "${ML_DIR}/upload"
  ln -sfn "$GEO_DIR" "${APP_DIR}/geodata"
  ln -sf "${APP_DIR}/cli/bin/immich" /usr/bin/immich
  ln -sf "${APP_DIR}/bin/immich-admin" /usr/bin/immich-admin
  msg_ok "Wired up ${app_label} paths"

  flavor_patch_media_repository

  mkdir -p /var/log/immich
  touch /var/log/immich/web.log /var/log/immich/ml.log
  chown -R immich:immich /var/log/immich
  flavor_chown_install

  FLAVOR_BUILT_VERSION="$(cat "$(flavor_version_file "$app_label")" 2>/dev/null || echo "$tag")"
  export FLAVOR_BUILT_VERSION
}

# ------------------------------------------------------------------------------
# flavor_build_plugins <app-label>
#
# Builds immich-plugin-core. Needs mise for the toolchain, extism-js for the JS
# PDK and binaryen's wasm-merge; the latter two are fetched by hand because
# fetch_and_deploy_gh_release cannot deploy a bare .gz and mise's github backend
# stopped exposing wasm-merge on PATH.
# ------------------------------------------------------------------------------
flavor_build_plugins() {
  local app_label="$1"

  msg_info "Building ${app_label} plugins"
  cd "$SRC_DIR" || return 1
  export MISE_TRUSTED_CONFIG_PATHS="${SRC_DIR}/mise.toml"
  export MISE_DISABLE_TOOLS=github:jellyfin/jellyfin-ffmpeg

  local mise_ok=0 i
  for i in 1 2 3; do
    $STD mise install && {
      mise_ok=1
      break
    }
    msg_warn "mise install failed (attempt $i/3) - retrying"
    sleep 5
  done
  [[ "$mise_ok" -eq 1 ]] || {
    msg_error "mise install failed three times, aborting"
    return 1
  }
  local mise_paths
  mise_paths="$(mise bin-paths 2>/dev/null | tr '\n' ':')"
  export PATH="${mise_paths}${PATH}"

  if ! command -v extism-js >/dev/null 2>&1; then
    local extism_arch
    extism_arch="$(arch_resolve x86_64 aarch64)"
    curl_download /tmp/extism-js.gz \
      "https://github.com/extism/js-pdk/releases/download/v1.6.0/extism-js-${extism_arch}-linux-v1.6.0.gz"
    gunzip -f /tmp/extism-js.gz
    install -m 0755 /tmp/extism-js /usr/local/bin/extism-js
    rm -f /tmp/extism-js
  fi

  if ! command -v wasm-merge >/dev/null 2>&1; then
    local binaryen_version binaryen_arch
    binaryen_version="$(grep -oiP 'binaryen"\s*=\s*"\Kversion_[0-9]+' "${SRC_DIR}/mise.toml" | head -n1)"
    [[ -z "$binaryen_version" ]] && binaryen_version="version_124"
    binaryen_arch="$(arch_resolve x86_64 aarch64)"
    curl_download /tmp/binaryen.tar.gz \
      "https://github.com/WebAssembly/binaryen/releases/download/${binaryen_version}/binaryen-${binaryen_version}-${binaryen_arch}-linux.tar.gz"
    tar -xzf /tmp/binaryen.tar.gz -C /opt
    rm -f /tmp/binaryen.tar.gz
    export PATH="/opt/binaryen-${binaryen_version}/bin:$PATH"
  fi

  $STD mise exec -- pnpm --filter @immich/sdk --filter @immich/plugin-sdk --filter @immich/plugin-core install --frozen-lockfile
  $STD mise exec -- pnpm --filter @immich/sdk --filter @immich/plugin-sdk --filter @immich/plugin-core build
  mkdir -p "$PLUGIN_DIR"
  cp -r ./packages/plugin-core/dist "${PLUGIN_DIR}/dist"
  cp ./packages/plugin-core/manifest.json "$PLUGIN_DIR"
  msg_ok "Built ${app_label} plugins"
}

# ------------------------------------------------------------------------------
# flavor_build_ml <app-label>
#
# Syncs the machine-learning venv. ~/.openvino, written by the original installer,
# selects the Intel OpenVINO extra (python3.13) over plain CPU (python3.11).
# ------------------------------------------------------------------------------
flavor_build_ml() {
  local app_label="$1"

  cd "${SRC_DIR}/machine-learning" || return 1
  mkdir -p "$ML_DIR"
  flavor_chown_install
  chown immich:immich ./uv.lock

  export VIRTUAL_ENV="${ML_DIR}/ml-venv"
  export UV_HTTP_TIMEOUT=300

  local ml_python ml_extra attempt
  if [[ -f ~/.openvino ]]; then
    ml_python="python3.13"
    ml_extra="openvino"
  else
    ml_python="python3.11"
    ml_extra="cpu"
  fi

  msg_info "Pre-installing Python ${ml_python} for machine-learning"
  for attempt in $(seq 1 3); do
    $STD sudo --preserve-env=VIRTUAL_ENV -Pnu immich uv python install "${ml_python}" && break
    [[ $attempt -lt 3 ]] && msg_warn "Python download attempt $attempt failed, retrying..." && sleep 5
  done
  msg_ok "Pre-installed Python ${ml_python}"

  msg_info "Installing ${app_label} machine-learning (${ml_extra})"
  for attempt in $(seq 1 3); do
    $STD sudo --preserve-env=VIRTUAL_ENV,UV_HTTP_TIMEOUT -Pnu immich \
      uv sync --extra "${ml_extra}" --no-dev --active --link-mode copy -n -p "${ml_python}" --managed-python && break
    [[ $attempt -lt 3 ]] && msg_warn "uv sync attempt $attempt failed, retrying..." && sleep 10
  done

  if [[ "$ml_extra" == "openvino" ]]; then
    patchelf --clear-execstack \
      "${VIRTUAL_ENV}/lib/python3.13/site-packages/onnxruntime/capi/onnxruntime_pybind11_state.cpython-313-$(arch_resolve "x86_64" "aarch64")-linux-gnu.so"
  fi
  msg_ok "Installed ${app_label} machine-learning"

  cd "$SRC_DIR" || return 1
  cp -a machine-learning/ann machine-learning/immich_ml "$ML_DIR"
  flavor_restore_ml_start
  [[ -f ~/.openvino ]] && sed -i "/intra_op/s/int = 0/int = os.cpu_count() or 0/" "${ML_DIR}/immich_ml/config.py"
  return 0
}

# ------------------------------------------------------------------------------
# flavor_wait_healthy [timeout-seconds]
#
# Polls the server's ping endpoint. Returns 1 on timeout — which is NOT proof of
# failure: the first start after a switch runs database migrations, and on a large
# library that can outlast any timeout worth waiting for. Callers should report,
# not panic.
# ------------------------------------------------------------------------------
flavor_wait_healthy() {
  local timeout="${1:-180}" waited=0

  msg_info "Waiting for the server to come up (up to ${timeout}s)"
  while ((waited < timeout)); do
    if curl -fsS --max-time 5 "http://127.0.0.1:2283/api/server/ping" >/dev/null 2>&1; then
      msg_ok "Server is responding on port 2283"
      return 0
    fi
    sleep 5
    waited=$((waited + 5))
  done

  msg_warn "Server has not answered on port 2283 after ${timeout}s"
  return 1
}

# ------------------------------------------------------------------------------
# flavor_slow_start_notice <backup-dir>
#
# Printed when the health check times out. Deliberately does not tell the user to
# roll back: a long migration looks exactly like this, and rolling back a database
# that is mid-migration is the worst thing they could do.
# ------------------------------------------------------------------------------
flavor_slow_start_notice() {
  local backup_dir="${1:-}"
  cat <<EOF

  The server is not answering yet. On a first start after a switch this is often
  just database migrations still running — the bigger the library, the longer.

  Watch it:
      journalctl -u immich-web -f
      tail -f /var/log/immich/web.log
  Check again later:
      curl -fsS http://127.0.0.1:2283/api/server/ping

  Last 40 lines of the web log:
EOF
  echo "  ----------------------------------------------------------------"
  tail -n 40 /var/log/immich/web.log 2>/dev/null | sed 's/^/  /' || echo "  (no web.log)"
  echo "  ----------------------------------------------------------------"
  cat <<EOF

  If it never comes up and the log shows a real error, the pre-switch backup is at
  ${backup_dir:-/opt/immich/backups/}

EOF
}
